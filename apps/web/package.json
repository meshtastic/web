{
  "name": "meshtastic-web",
  "version": "2.6.6-0",
  "description": "Meshtastic web client",
  "homepage": "https://meshtastic.org",
  "bugs": {
    "url": "https://github.com/meshtastic/web/issues"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meshtastic/web.git"
  },
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "setup:certs": "mkcert localhost 127.0.0.1 ::1",
    "prebuild": "pnpm --filter @meshtastic/sdk-kmp ensure-dist",
    "build": "vite build",
    "build:analyze": "BUNDLE_ANALYZE=true pnpm run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check": "pnpm lint && pnpm format",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "predev": "pnpm --filter @meshtastic/sdk-kmp ensure-dist",
    "dev": "vite",
    "dev:https": "USE_HTTPS=true vite",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "docker:build": "docker build -t meshtastic-web:latest -f ./infra/Containerfile .",
    "package": "gzipper c -i html,js,css,png,ico,svg,json,webmanifest,txt dist dist/output && tar -cvf dist/build.tar -C ./dist/output/ ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@meshtastic/protobufs": "workspace:*",
    "@meshtastic/sdk-kmp": "workspace:*",
    "@noble/curves": "^2.4.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/browser-instrumentation": "0.12.1",
    "@opentelemetry/otlp-transformer": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@preact/signals-core": "^1.14.4",
    "@sqlite.org/sqlite-wasm": "3.51.2-build9",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@turf/turf": "^7.4.0",
    "@types/node": "^26.6.5",
    "@types/web-bluetooth": "^0.0.21",
    "better-result": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "i18next": "^27.2.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.4",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.21",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "6.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^18.0.3",
    "react-map-gl": "8.1.3",
    "react-qrcode-logo": "^4.1.0",
    "sqlocal": "^0.18.0",
    "tslog": "^5.2.0",
    "vaul": "^1.1.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "^4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/serviceworker": "^0.0.203",
    "@types/sql.js": "^1.4.11",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "gzipper": "^8.3.0",
    "happy-dom": "^21.0.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "sql.js": "^1.16.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tar": "^7.5.22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
